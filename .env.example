# Copy this file to .env and fill in real values:  cp .env.example .env
# .env is git-ignored; this example file is committed so others know what to set.

# --- Django ---
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Postgres (read by both Django and docker-compose.yml) ---
POSTGRES_DB=codebase_qna
POSTGRES_USER=codebase_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
